# Copy to .env (gitignored) and fill in. The caddy service loads this via `env_file: .env`,
# and the Caddyfile reads {$VARS} from the resulting container environment.

# Email Let's Encrypt uses for expiry/issue notifications.
ACME_EMAIL=you@example.com

# Public hostnames. A records for BOTH must resolve to this box BEFORE the first
# `docker compose up` — Caddy needs them for the ACME challenge.
#
# Use the convention "site at mtb.<domain>, Overpass at overpass.<domain>" (same base domain,
# ≥3 labels): the static app derives its Overpass endpoint from its own origin by swapping the
# first label to "overpass" (see app.js / sw.js). Diverge from it and the app falls back to the
# public Overpass mirrors — the site still works, it just won't use your self-hosted instance.
SITE_DOMAIN=mtb.example.com
OVERPASS_DOMAIN=overpass.example.com

# --- Basic auth for the site --------------------------------------------------------------
# Username + a bcrypt hash of the password. Every `$` in the hash MUST be doubled to `$$`
# here (compose's env_file interpolates `$`); Caddy receives the single-$ value. Generate it
# already-escaped — full rationale and the post-`up` verification are in ROCKY.md steps 4/7:
#   echo 'your-password' | docker run --rm -i caddy:2 caddy hash-password | sed 's/\$/\$\$/g'
SITE_USER=rider
SITE_PASSWORD_HASH=$$2a$$14$$REPLACE_ME_WITH_A_REAL_BCRYPT_HASH

# --- Overpass CORS allow-list -------------------------------------------------------------
# The site's origin (scheme + host, no trailing slash) = https:// + SITE_DOMAIN, with the
# dots ESCAPED. It is inserted into the Caddyfile anchored as ^(...)$, so "mtb.example.com"
# cannot be matched by "mtbXexample.com". Backslashes survive compose interpolation; only $
# is special there.
SITE_ORIGIN_REGEX=https://mtb\.example\.com
