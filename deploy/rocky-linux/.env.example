# Copy to .env (gitignored) and fill in. The caddy service loads this via `env_file: .env`,
# and the Caddyfile reads {$VARS} from the resulting container environment.

# Email Let's Encrypt uses for expiry/issue notifications.
ACME_EMAIL=you@example.com

# Public hostname. Its A record must resolve to this box BEFORE the first
# `docker compose up` — Caddy needs it for the ACME challenge.
SITE_DOMAIN=mtb.example.com

# --- Basic auth for the site --------------------------------------------------------------
# Auth is OPTIONAL and defaults to ON. Leave SITE_AUTH_SNIPPET unset (delete the line) to
# require a login; set it to the off file to serve the map publicly. The value is the
# in-container path (the ./caddy dir mounts at /etc/caddy) — paste it verbatim, no bare
# filenames:
#   SITE_AUTH_SNIPPET=/etc/caddy/auth-on.conf    # require basic auth (same as unset/default)
#   SITE_AUTH_SNIPPET=/etc/caddy/auth-off.conf   # public, no auth
# Do NOT leave it blank (`SITE_AUTH_SNIPPET=`): that expands to a bare `import` and Caddy
# refuses to start (fail-closed — the site goes down, it does NOT fall back to public). To
# disable auth, set the off path explicitly; to keep auth on, use the on path or delete the line.
SITE_AUTH_SNIPPET=/etc/caddy/auth-on.conf
#
# Only used when auth is ON (auth-on.conf): username + a bcrypt hash of the password. Every `$`
# in the hash MUST be doubled to `$$` here (compose's env_file interpolates `$`); Caddy receives
# the single-$ value. Generate it already-escaped — full rationale and the post-`up`
# verification are in README.md steps 2/5:
#   echo 'your-password' | docker run --rm -i caddy:2 caddy hash-password | sed 's/\$/\$\$/g'
SITE_USER=rider
SITE_PASSWORD_HASH=$$2a$$14$$REPLACE_ME_WITH_A_REAL_BCRYPT_HASH

