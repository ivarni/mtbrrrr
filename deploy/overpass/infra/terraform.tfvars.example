# Copy to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to source control.

# From the Scaleway console → project settings. Make a project just for mtbrrrr.
project_id = "00000000-0000-0000-0000-000000000000"

# The endpoint becomes https://<subdomain>.<dns_zone>/api/interpreter.
# manage_dns = false: you add the A record at your own registrar (see INFRA.md).
# Flip it to true only if the zone is delegated to Scaleway — check `scw dns zone list`.
dns_zone   = "example.com"
subdomain  = "overpass"
manage_dns = false

region = "fr-par"
zone   = "fr-par-1"

# 2 vCPU / 4 GB — sized for serving queries, which is light work.
# The INITIAL IMPORT is much heavier. If it crawls or gets OOM-killed, import on something
# bigger (e.g. PRO2-XXS, 2 vCPU / 8 GB — the reference import took ~45 min there) and then
# drop back to this. Resizing never re-imports; the DB lives on its own volume.
instance_type  = "PLAY2-NANO"
volume_size_gb = 50

# Narrow this to your own address if you can, e.g. "203.0.113.7/32".
ssh_allowed_ip = "0.0.0.0/0"

# Set this. Scaleway injects only the keys registered in *this* project, and only at boot,
# so a brand-new project without it means no SSH access — and fixing that afterwards costs
# an instance replacement (and a fresh 20-60 min import). `cat ~/.ssh/id_ed25519.pub`
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
