#cloud-config
# Rendered by Terraform (main.tf) and handed to the instance as cloud-init user_data.
# Runs once on first boot: mounts the block volume, installs Docker, starts the stack.
# Later changes go out with ../deploy.sh — editing this file only affects a *new* instance,
# and replacing the instance means re-importing the Norway extract (20–60 min).

package_update: true
packages:
  - ca-certificates
  - curl
  - rsync

write_files:
  - path: /opt/overpass/docker-compose.yml
    permissions: "0644"
    content: |
      ${indent(6, compose)}

  - path: /opt/overpass/Caddyfile
    permissions: "0644"
    content: |
      ${indent(6, caddyfile)}

  # Kept on disk rather than inlined into runcmd so it can be re-run by hand when a boot
  # goes sideways (see the troubleshooting section of INFRA.md). Every step is idempotent.
  - path: /opt/overpass/bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      # Find the data volume: the first whole disk with nothing mounted off it. Scaleway's
      # /dev/disk/by-id paths for SBS volumes aren't stable enough to hardcode, and this
      # reliably skips the root volume, which always has / mounted.
      DEV=""
      for d in $(lsblk -dnro NAME,TYPE | awk '$2 == "disk" { print $1 }'); do
        if [ -z "$(lsblk -nro MOUNTPOINT "/dev/$d" | tr -d '[:space:]')" ]; then
          DEV="/dev/$d"
          break
        fi
      done
      if [ -z "$DEV" ]; then
        echo "bootstrap: no unmounted data disk found (see INFRA.md troubleshooting)" >&2
        exit 1
      fi

      # Only format a blank disk. An existing filesystem means the Overpass DB is already
      # there — e.g. the instance was replaced but the volume kept — so never reformat.
      blkid "$DEV" || mkfs.ext4 -F "$DEV"

      mkdir -p /srv/overpass
      grep -q "^$DEV /srv/overpass " /etc/fstab \
        || echo "$DEV /srv/overpass ext4 defaults,nofail 0 2" >> /etc/fstab
      mount -a
      mkdir -p /srv/overpass/db

      command -v docker >/dev/null || curl -fsSL https://get.docker.com | sh

      cd /opt/overpass
      docker compose up -d

runcmd:
  - [/opt/overpass/bootstrap.sh]
